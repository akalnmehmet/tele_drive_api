# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Docker Compose ile ayağa kaldırıyorsanız host=localhost, port=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tele_drive
DB_USER=postgres
DB_PASS=postgres

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# Üretimde en az 64 karakterlik rastgele bir string kullanın
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── E-posta (Nodemailer) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@teledrive.io

# ── Raporlar ─────────────────────────────────────────────────────────────────
REPORTS_DIR=./tmp/reports
